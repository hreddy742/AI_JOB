# Core
# Any secret that was previously committed to a local `.env` must be treated as exposed and rotated.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@pgbouncer:5432/apex_apply
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-local-secret
TRUSTED_PROXY_IPS=127.0.0.1,::1
APP_VERSION=0.1.0
GLITCHTIP_DSN=
GLITCHTIP_SECRET_KEY=replace-with-glitchtip-secret
GRAFANA_PASSWORD=admin

# JWT
JWT_SECRET_KEY=replace-with-local-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookie
COOKIE_DOMAIN=
# Keep true for production-safe defaults; set to false only for local HTTP dev.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Email SMTP (local default: Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Apex Apply
SMTP_FROM_EMAIL=no-reply@apexapply.local

# Gmail example (requires App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USE_TLS=false
# SMTP_USERNAME=youraddress@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# SMTP_FROM_EMAIL=youraddress@gmail.com

# Rate limiting
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_RESET_MAX=3
RATE_LIMIT_RESET_WINDOW_SECONDS=3600

# Account lockout
MAX_FAILED_LOGINS=10
ACCOUNT_LOCKOUT_MINUTES=15

# Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/backend
NEXT_PUBLIC_API_URL=/backend
NEXT_PUBLIC_WS_URL=ws://localhost:8001
INTERNAL_API_BASE_URL=http://api:8001

# Local LLM / Copilot
OLLAMA_BASE_URL=http://ollama:11434
WRITER_MODEL=mistral:7b-instruct
REVIEWER_MODEL=mistral:7b-instruct
REFERRAL_MODEL=qwen2:1.5b
COPILOT_MODEL=llama3:8b
KNOWLEDGE_MODEL=qwen2:1.5b
COPILOT_MAX_HISTORY_MESSAGES=20
EMBEDDING_MODEL=intfloat/e5-large-v2
EMBEDDING_DIMENSION=1024

# Ingestion
ENABLE_BACKGROUND_INGESTION=false
INGESTION_INTERVAL_SECONDS=3600
ENABLE_JOB_EMBEDDINGS=false
ENABLE_JOB_REQUIREMENTS_ANALYSIS=true
JOB_REQUIREMENTS_MAX_ATTEMPTS=5
JOB_REQUIREMENTS_BATCH_SIZE=100
JOB_REQUIREMENTS_STALE_MINUTES=15
GLOBAL_JOBS_CATALOG_ENABLED=true
ENABLE_CONTINUOUS_USA_SCRAPER=false
ENABLE_RERANKING=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_MAX_CANDIDATES=40
RERANK_MIN_CANDIDATES=5
RERANK_TIMEOUT_MS=1200
JOB_RETENTION_DAYS=3650

# Search
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=apex-apply-local-key
TYPESENSE_JOBS_COLLECTION=jobs

# Optional source-expansion overrides (comma-separated)
GREENHOUSE_BOARD_TOKENS=
LEVER_COMPANIES=
PROXY_URL=
# RSS_FEED_URLS=https://example.com/careers/rss,https://another.example/jobs.atom

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=apex-apply

# Optional source API keys
ADZUNA_APP_ID=
ADZUNA_API_KEY=
CAREERJET_API_KEY=
USAJOBS_API_KEY=
THE_MUSE_API_KEY=
RSS_FEED_URLS=

# Handshake (optional — enables Playwright-authenticated scraping)
HANDSHAKE_ENABLED=false
HANDSHAKE_EMAIL=
HANDSHAKE_PASSWORD=
