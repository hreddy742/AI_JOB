# Core
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/apex_apply
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me

# JWT
JWT_SECRET_KEY=replace_with_128_char_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookie
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Email SMTP (local default: Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Apex Apply
SMTP_FROM_EMAIL=no-reply@apexapply.local

# Gmail example (requires App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USE_TLS=false
# SMTP_USERNAME=youraddress@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# SMTP_FROM_EMAIL=youraddress@gmail.com

# Rate limiting
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=0
RATE_LIMIT_REGISTER_MAX=0
RATE_LIMIT_REGISTER_WINDOW_SECONDS=0
RATE_LIMIT_RESET_MAX=3
RATE_LIMIT_RESET_WINDOW_SECONDS=3600

# Account lockout
MAX_FAILED_LOGINS=10
ACCOUNT_LOCKOUT_MINUTES=0

# Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/backend
NEXT_PUBLIC_API_URL=/backend
NEXT_PUBLIC_WS_URL=ws://localhost:8001
INTERNAL_API_BASE_URL=http://api:8001

# Ingestion
ENABLE_BACKGROUND_INGESTION=false
INGESTION_INTERVAL_SECONDS=3600
ENABLE_JOB_EMBEDDINGS=false
JOB_RETENTION_DAYS=3650

# Optional source-expansion overrides (comma-separated)
# GREENHOUSE_BOARD_TOKENS=openai,airbnb,stripe
# LEVER_COMPANIES=netflix,uber,canva
# JOBSPY_SITE_NAMES=linkedin,indeed,zip_recruiter,glassdoor

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Optional source API keys
ADZUNA_APP_ID=
ADZUNA_API_KEY=
USAJOBS_API_KEY=
THE_MUSE_API_KEY=
