# Core
# Rotate any value that was ever committed to git or shared outside your secret manager.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/apex_apply
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace_with_long_random_secret

# JWT
JWT_SECRET_KEY=replace_with_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookie
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# URLs
FRONTEND_URL=https://YOUR_SERVER_IP_OR_DOMAIN
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=/ws
INTERNAL_API_BASE_URL=http://api:8001

# SMTP (set for real email verification)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Apex Apply
SMTP_FROM_EMAIL=no-reply@example.com

# MinIO
MINIO_ACCESS_KEY=replace_with_minio_user
MINIO_SECRET_KEY=replace_with_minio_password

# Typesense
TYPESENSE_API_KEY=replace_with_typesense_api_key

# Optional source API keys
ADZUNA_APP_ID=
ADZUNA_API_KEY=
USAJOBS_API_KEY=
THE_MUSE_API_KEY=

# Ranking
ENABLE_RERANKING=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_MAX_CANDIDATES=40
RERANK_MIN_CANDIDATES=5
RERANK_TIMEOUT_MS=1200
